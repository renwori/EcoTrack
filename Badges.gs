  ["Какое дерево часто называют символом России?",["Берёза","Пальма","Баобаб","Кипарис"],"Берёза растёт по всей стране и стала её символом.",1],["Почему уток лучше не кормить хлебом?",["Хлеб вреден для их здоровья и загрязняет воду","Утки не едят хлеб","Хлеб тонет","Утки обидятся"],"Хлеб плохо подходит уткам, а остатки портят воду в пруду.",1],
  ["Что помогает сохранить тепло дома зимой?",["Утеплённые окна","Открытая форточка весь день","Кондиционер","Холодильник"],"Через щели в окнах уходит много тепла и энергии.",1],["Какая электростанция использует силу воды?",["ГЭС","АЭС","Угольная ТЭЦ","Солнечная панель"],"ГЭС - гидроэлектростанция, её турбины крутит поток воды.",2],
  ["Кто такие волонтёры-экологи?",["Люди, которые бесплатно помогают природе","Химики","Лесорубы","Продавцы"],"Волонтёры убирают мусор, сажают деревья и помогают животным.",1],["Как называется превращение пищевых отходов в удобрение?",["Компостирование","Сжигание","Захоронение","Заморозка"],"В компосте очистки превращаются в питательную землю.",2],
  ["Какое животное самое большое на Земле?",["Синий кит","Слон","Жираф","Белая акула"],"Синий кит длиннее 25 метров и весит больше 100 тонн.",1],["Где на Земле больше всего пресной воды?",["В ледниках","В реках","В лужах","В облаках"],"Большая часть пресной воды заморожена в ледниках.",2],
  ["Что такое экосистема?",["Живые организмы вместе со средой, где они живут","Компьютерная программа","Вид пластика","Название заповедника"],"Лес, озеро или луг - всё это экосистемы.",3],["Какое из этих растений - хищное?",["Росянка","Ромашка","Одуванчик","Подсолнух"],"Росянка ловит насекомых липкими капельками на листьях.",2],
  ["Почему коралловые рифы важны?",["Это дом для множества морских животных","Из них делают пластик","Они очищают воздух в городах","Они согревают океан"],"На рифах живёт огромное количество видов рыб и других животных.",2],["Чем опасны пластиковые пакеты для морских черепах?",["Черепахи путают их с медузами и глотают","Пакеты их пугают","Пакеты слишком тяжёлые","Ничем"],"Проглоченный пакет может погубить черепаху.",1],
  ["Как называется наука о связях живых организмов со средой?",["Экология","Геометрия","Астрономия","Грамматика"],"Экология изучает, как живые организмы связаны друг с другом и с природой.",2],["Какая энергия добывается из тепла недр Земли?",["Геотермальная","Ветровая","Солнечная","Приливная"],"Геотермальные станции используют тепло горячих подземных источников.",3],
  ["Зачем сортировать мусор?",["Чтобы отходы можно было переработать","Чтобы мусора стало больше","Так красивее","Чтобы мусор быстрее сгнил"],"Рассортированные отходы становятся сырьём для новых вещей.",1],["Что нужно сдать в пункт приёма электроники?",["Старый телефон","Банановую кожуру","Газету","Стеклянную банку"],"В электронике есть ценные и опасные вещества.",1],
  ["Какое животное строит плотины на реках?",["Бобр","Выдра","Ёж","Белка"],"Бобры строят плотины из веток и брёвен.",1],["Как называют виды, которых в природе осталось очень мало?",["Редкие и исчезающие","Домашние","Сорные","Декоративные"],"Редкие виды охраняют законом.",1],
  ["Какой газ образуется на свалках при гниении отходов?",["Метан","Кислород","Гелий","Неон"],"Метан - парниковый газ, он сильно нагревает атмосферу.",3],["Что делать, если в лесу попалось гнездо с птенцами?",["Не трогать и уйти","Забрать птенцов","Потрогать птенцов руками","Сломать ветку"],"Птенцов кормят родители, им нельзя мешать.",1],
  ["Какая птица хорошо видит ночью?",["Сова","Голубь","Ласточка","Воробей"],"Совы охотятся ночью и отлично видят в темноте.",1],["Чем полезны дождевые черви?",["Они рыхлят и удобряют почву","Они едят пластик","Они опыляют цветы","Они чистят воздух"],"Черви перемешивают почву, и растениям легче расти.",1],
  ["Зачем закрывать кран, пока намыливаешь руки?",["Чтобы не тратить воду зря","Чтобы мыло не смылось","Так быстрее","Незачем"],"Даже несколько секунд открытого крана - это литры воды.",1],["Как называется последовательность организмов, в которой каждый служит пищей следующему?",["Пищевая цепь","Экологическая ниша","Популяция","Ареал"],"Например: трава - заяц - лиса. По пищевой цепи передаются вещества и энергия.",3],
  ["Какая доля энергии в среднем переходит на следующий уровень пищевой цепи?",["Около 10%","Около 50%","Около 90%","Вся энергия"],"Правило 10%: большая часть энергии тратится на жизнь организма и рассеивается в виде тепла.",3],["Как называются организмы, которые сами создают органические вещества из неорганических?",["Продуценты","Консументы","Редуценты","Паразиты"],"Продуценты - это в основном растения и водоросли. Они используют энергию света.",3],
  ["Кто в экосистеме разлагает мёртвые остатки до минеральных веществ?",["Редуценты - бактерии и грибы","Продуценты","Хищники","Травоядные"],"Редуценты возвращают вещества в почву, и растения снова их используют.",3],["Как называется роль вида в экосистеме: чем он питается, где живёт, с кем взаимодействует?",["Экологическая ниша","Ареал","Популяция","Биотоп"],"Экологическая ниша - это «профессия» вида в природе, а ареал - его «адрес».",3],
  ["Как называется территория, на которой встречается вид?",["Ареал","Экологическая ниша","Биоценоз","Заказник"],"Ареал может быть огромным, как у волка, или крошечным, как у некоторых островных видов.",3],["Какой из этих факторов относится к абиотическим?",["Температура воздуха","Хищники","Паразиты","Конкуренция за пищу"],"Абиотические факторы - это неживая природа: свет, температура, влажность, состав почвы.",3],
  ["Как называется постепенная смена одного сообщества другим, например зарастание вырубки лесом?",["Сукцессия","Мутация","Эрозия","Миграция"],"После пожара или вырубки сначала растут травы, потом кустарники и лиственные деревья, а со временем снова может вырасти хвойный лес.",3],["Как называют вид, который живёт только в одном месте на Земле?",["Эндемик","Инвазивный вид","Космополит","Гибрид"],"Например, байкальская нерпа - эндемик Байкала, больше она нигде не живёт.",3],
  ["Как называют вид, завезённый в новый регион и вытесняющий местные виды?",["Инвазивный","Эндемичный","Реликтовый","Исчезающий"],"Например, борщевик Сосновского когда-то завезли как корм для скота, а теперь он захватывает поля и обочины.",3],["Что сильнее всего сокращает биоразнообразие на планете?",["Разрушение мест обитания","Солнечные вспышки","Перелёты птиц","Землетрясения"],"Главная угроза для видов - вырубка лесов, распашка земель, осушение болот и застройка.",3],
  ["Какое вещество из фреонов разрушает озоновый слой?",["Хлор","Азот","Кислород","Водород"],"В стратосфере фреоны выделяют хлор, который разрушает молекулы озона.",3],["Что защищает Монреальский протокол 1987 года?",["Озоновый слой","Водно-болотные угодья","Китов","Тропические леса"],"Протокол запретил вещества, разрушающие озоновый слой, и озоновая дыра начала затягиваться.",3],
  ["Какой международный договор 2015 года направлен на сдерживание глобального потепления?",["Парижское соглашение","Монреальский протокол","Рамсарская конвенция","Киотский протокол"],"Страны договорились удерживать рост средней температуры Земли намного ниже 2 °C по сравнению с доиндустриальным уровнем.",3],["Что охраняет Рамсарская конвенция?",["Водно-болотные угодья","Озоновый слой","Космос","Месторождения нефти"],"Конвенция 1971 года защищает болота, озёра и поймы - важные места обитания птиц.",3],
  ["Какие вещества вызывают кислотные дожди?",["Оксиды серы и азота","Оксиды железа","Оксид кальция","Оксид кремния"],"Оксиды серы и азота от сжигания топлива растворяются в каплях воды и образуют кислоты.",3],["Как называется бурное разрастание водорослей в водоёме из-за избытка удобрений?",["Эвтрофикация","Эрозия","Сукцессия","Коррозия"],"Удобрения смываются с полей, водоросли разрастаются, а когда отмирают и гниют, в воде становится мало кислорода и гибнет рыба.",3],
  ["Как называется разрушение почвы ветром и водой?",["Эрозия","Коррозия","Эвтрофикация","Сукцессия"],"Эрозию усиливают вырубка лесов и распашка склонов. Деревья и травы удерживают почву корнями.",3],["Что такое углеродный след?",["Количество парниковых газов от деятельности человека или товара","След сажи на стене","Залежи угля","Отпечаток растения в угле"],"Углеродный след считают в килограммах CO₂. Его можно уменьшить: меньше ездить на машине, беречь энергию, реже покупать новое.",3],
  ["Как называются частицы пластика размером меньше 5 мм?",["Микропластик","Нанотрубки","Полимерные волокна","Гранулы"],"Микропластик образуется, когда разрушается крупный пластик. Его находят даже в арктических льдах.",3],["Почему в центре большого города обычно теплее, чем за городом?",["Асфальт и здания нагреваются и отдают тепло - это «городской остров тепла»","Из-за парникового эффекта только над городом","Город ближе к Солнцу","Из-за деревьев в парках"],"Асфальт, бетон, машины и отопление нагревают воздух, а зелени, которая охлаждает, мало.",3],
  ["Таяние какого льда поднимает уровень Мирового океана?",["Ледников на суше","Плавающих морских льдов","Льда на реках","Сосулек"],"Плавающий лёд уже вытесняет воду, поэтому его таяние почти не меняет уровень. А лёд с суши добавляет в океан новую воду.",3],["Какой парниковый газ выделяет животноводство, особенно коровы?",["Метан","Кислород","Азот","Гелий"],"Метан образуется при переваривании травы. Он удерживает тепло намного сильнее углекислого газа.",3],
  ["Почему сжигание угля особенно вредно для климата?",["На единицу энергии выделяется больше CO₂, чем от нефти и газа","Уголь поглощает кислород из почвы","Уголь охлаждает воздух","Уголь - возобновляемый ресурс"],"Уголь почти целиком состоит из углерода, поэтому при сжигании даёт больше всего CO₂ среди ископаемых видов топлива.",3],["Какой недостаток есть у атомных электростанций, хотя при работе они почти не выделяют CO₂?",["Радиоактивные отходы","Много дыма","Зависят от ветра","Работают только днём"],"Отработанное ядерное топливо очень долго остаётся опасным, его нужно надёжно хранить.",3],
  ["Что означает ПДК?",["Предельно допустимая концентрация вредного вещества","Природный двигатель климата","Прибор для измерения ветра","Проект дорожного комплекса"],"ПДК - наибольшее содержание вещества в воздухе, воде или почве, которое не вредит здоровью.",3],["К какому классу опасности относятся отработанные ртутные лампы?",["I класс - чрезвычайно опасные","III класс","V класс - практически неопасные","Они не опасны"],"Ртуть очень ядовита, поэтому ртутные лампы и градусники - отходы I класса опасности.",3],
  ["Чем опасно таяние вечной мерзлоты?",["Выделяется метан, рушатся дома и дороги","Почва везде становится плодороднее","Опускается уровень океана","Ничем"],"Мерзлота занимает больше половины территории России. Когда она тает, грунт проседает, а из него выходят парниковые газы.",3],["В какой стране больше всего лесов?",["Россия","Бразилия","Канада","США"],"На Россию приходится около пятой части всех лесов мира.",3],
  ["Какая часть пресной поверхностной воды мира находится в Байкале?",["Около 20%","Около 1%","Около 50%","Около 90%"],"Байкал - самое глубокое озеро на Земле и огромный запас чистой пресной воды.",3],["Как называется восстановление нарушенной земли, например на месте старого карьера или свалки?",["Рекультивация","Эрозия","Урбанизация","Опустынивание"],"При рекультивации засыпают ямы, насыпают плодородную почву и сажают растения, чтобы земля снова стала живой.",3],
  ["Какой шаг в принципе «сократи, используй снова, переработай» самый важный?",["Сократить потребление","Переработать","Сжечь","Закопать"],"Лучший мусор - тот, который не появился. Переработка тоже тратит энергию.",3],["Почему вырубка тропических лесов усиливает потепление?",["Деревья перестают поглощать CO₂, а при сжигании выделяют его","Без леса Земля ближе к Солнцу","Лес охлаждает Солнце","Вырубка не влияет на климат"],"Леса хранят огромное количество углерода. При вырубке и пожарах он попадает в атмосферу.",3],
  ["Какой газ образуется при неполном сгорании топлива и особенно опасен, потому что не имеет запаха?",["Угарный газ","Кислород","Азот","Гелий"],"Угарный газ мешает крови переносить кислород. Он есть в выхлопах машин и дыме.",3],["Что такое водный след товара?",["Объём воды, нужный для его производства","Вода в составе товара","След от капель на упаковке","Число рек рядом с заводом"],"Например, на выращивание хлопка для одной футболки уходят тысячи литров воды.",3],
  ["Какое вещество когда-то добавляли в бензин, а потом запретили из-за вреда здоровью?",["Соединения свинца","Этиловый спирт","Вода","Метан"],"Свинец из выхлопов накапливался в воздухе и почве и вредил здоровью, особенно детей.",3]]},
 myth:{per:3,fixed:true,opts:["Правда","Миф"],q:[
  ["Алюминиевую банку можно перерабатывать почти бесконечно.",0,"Правда: алюминий почти не теряет свойств при переработке.",2],["Пластиковый пакет разлагается за пару месяцев.",1,"Миф: пакету нужны сотни лет.",1],
  ["Одно дерево может быть домом для сотен видов насекомых.",0,"Правда: на старых деревьях живут сотни видов насекомых, птицы и грибы.",1],["Зарядка в розетке без телефона совсем не тратит электричество.",1,"Миф: она всё равно понемногу потребляет энергию.",2],
  ["Батарейку можно выбросить в обычную урну - она безопасна.",1,"Миф: вещества из батарейки отравляют почву и воду.",1],["Стекло можно перерабатывать много раз без потери качества.",0,"Правда: из старого стекла получается такое же новое.",2],
  ["Душ обычно расходует меньше воды, чем ванна.",0,"Правда: короткий душ требует в несколько раз меньше воды.",1],["Бумагу можно перерабатывать бесконечно.",1,"Миф: волокна укорачиваются, бумагу перерабатывают примерно 5-7 раз.",2],
  ["Пчёлы важны для урожая многих фруктов и овощей.",0,"Правда: без опыления не будет яблок, огурцов и многих других плодов.",1],["В океане мусор собирается в огромные «мусорные пятна».",0,"Правда: течения сносят пластик в огромные скопления.",2],
  ["Почти весь кислород на Земле производят деревья.",1,"Миф: больше половины кислорода дают морские водоросли и фитопланктон.",3],["Телевизор, выдернутый из розетки, продолжает тратить электричество.",1,"Миф: без розетки прибор ничего не потребляет.",2],
  ["Энергосберегающие лампы нужно сдавать в пункты приёма.",0,"Правда: в них есть ртуть.",2],["Магазинные чеки всегда можно сдать в макулатуру.",1,"Миф: чеки обычно печатают на термобумаге, её не перерабатывают.",2],
  ["Очистки от овощей и фруктов можно компостировать.",0,"Правда: из них получается отличное удобрение.",1],["Пластиковые бутылки можно переработать.",0,"Правда: из них делают новое волокно и упаковку.",1],
  ["Если выбросить мусор в реку, он исчезнет.",1,"Миф: течение уносит мусор дальше, и он загрязняет моря.",1],["Деревья помогают уменьшить шум в городе.",0,"Правда: зелёные насаждения поглощают часть шума.",1],
  ["Белые медведи живут в Антарктиде.",1,"Миф: белые медведи живут в Арктике, на севере планеты.",1],["Пчёлы - единственные опылители растений.",1,"Миф: растения опыляют ещё шмели, бабочки, птицы и даже летучие мыши.",1],
  ["Светодиодные лампы служат дольше обычных.",0,"Правда: они работают в десятки раз дольше ламп накаливания.",1],["Потепление климата значит, что каждый день будет жарко.",1,"Миф: меняется климат в целом, а погода может быть и холодной.",2],
  ["Мидии очищают воду.",0,"Правда: мидии фильтруют воду, пропуская через себя десятки литров в сутки.",2],["Жир можно спокойно выливать в раковину.",1,"Миф: жир застывает в трубах и загрязняет воду.",1],
  ["Большинство лесных пожаров возникает по вине людей.",0,"Правда: чаще всего виноваты непотушенные костры и окурки.",2],["Перерабатывать можно только новые вещи.",1,"Миф: перерабатывают как раз использованные вещи.",1],
  ["Летучие мыши помогают бороться с комарами.",0,"Правда: за ночь летучая мышь может съесть сотни насекомых.",1],["Стеклянную банку перед сдачей стоит сполоснуть.",0,"Правда: чистое вторсырьё легче переработать.",1],
  ["Мох растёт только с северной стороны деревьев.",1,"Миф: мох растёт там, где влажно и тенисто, - с любой стороны.",2],["Электричество из розетки никак не влияет на природу.",1,"Миф: большую часть электричества получают на станциях, которые влияют на природу.",2],
  ["Ежи носят яблоки на своих иголках.",1,"Миф: ежи едят в основном насекомых, а яблоки на иголках - выдумка из мультфильмов.",1],["Совы могут повернуть голову почти на 270 градусов.",0,"Правда: у сов очень гибкая шея.",1],
  ["Страусы прячут голову в песок от страха.",1,"Миф: страусы так не делают - они убегают или защищаются.",1],["Летучие мыши слепые.",1,"Миф: летучие мыши видят, а в темноте ещё и ориентируются по звуку.",1],
  ["Золотая рыбка помнит только 3 секунды.",1,"Миф: рыбки помнят события неделями и месяцами.",1],["Хамелеоны меняют цвет только чтобы спрятаться.",1,"Миф: чаще они меняют цвет от настроения, температуры и чтобы общаться.",2],
  ["Деревья обмениваются веществами через корни и грибы.",0,"Правда: под землёй корни деревьев связаны сетью грибов.",3],["Кит - это рыба.",1,"Миф: кит - млекопитающее, он дышит воздухом и кормит детёнышей молоком.",1],
  ["У пауков шесть ног.",1,"Миф: у пауков восемь ног.",1],["Некоторые виды бамбука вырастают почти на метр за сутки.",0,"Правда: бамбук - одно из самых быстрорастущих растений.",2],
  ["Пингвины живут на Северном полюсе.",1,"Миф: пингвины живут в Южном полушарии.",1],["Самые высокие деревья на Земле - секвойи.",0,"Правда: секвойи вырастают выше 110 метров.",2],
  ["Комнатные растения выделяют кислород.",0,"Правда: днём при свете растения выделяют кислород.",1],["Если сдавать макулатуру, можно сберечь деревья.",0,"Правда: из переработанной бумаги делают новую, и деревьев рубят меньше.",1],
  ["Посуда с надписью «биоразлагаемая» исчезает в любой луже за неделю.",1,"Миф: многим таким материалам нужны особые условия на заводах.",2],["Медведи зимой полностью замерзают.",1,"Миф: медведь спит в берлоге, а его тело почти не остывает.",1],
  ["Солнечные панели работают и в пасмурную погоду, только слабее.",0,"Правда: часть света проходит сквозь облака.",2],["Муравьи могут поднять груз во много раз тяжелее себя.",0,"Правда: муравьи - настоящие силачи.",1],
  ["Сосна - лиственное дерево.",1,"Миф: сосна - хвойное дерево.",1],["Дельфины спят с одним открытым глазом.",0,"Правда: у дельфинов по очереди отдыхает одна половина мозга.",2],
  ["Чем больше в упаковке разного пластика, тем проще её переработать.",1,"Миф: упаковку из нескольких материалов переработать сложнее всего.",2],["Опавшие листья можно использовать как удобрение.",0,"Правда: из листьев получается хороший компост.",1],
  ["Лягушки бывают ядовитыми.",0,"Правда: например, тропические лягушки-древолазы.",1],["Телевизор в режиме ожидания совсем не тратит энергию.",1,"Миф: в режиме ожидания он всё равно понемногу потребляет электричество.",2],
  ["Батарейки можно выбрасывать вместе с пластиком.",1,"Миф: батарейки сдают отдельно в специальные пункты.",1],["Медоносная пчела погибает после укуса.",0,"Правда: пчела оставляет жало в коже и погибает.",1],
  ["Кактусы растут только в пустынях.",1,"Миф: многие кактусы растут в тропических лесах и горах.",2],["Вокруг Земли летает космический мусор.",0,"Правда: вокруг планеты кружат тысячи обломков спутников и ракет.",2],
  ["Синий кит - самое крупное животное за всю историю Земли.",0,"Правда: синий кит крупнее любого известного динозавра.",1],["Возраст срубленного дерева можно узнать по кольцам на пне.",0,"Правда: каждый год дерево добавляет одно годичное кольцо.",1],
  ["Лисы впадают в спячку на зиму.",1,"Миф: лисы активны всю зиму и охотятся под снегом.",1],["Старую одежду можно только выбросить.",1,"Миф: её можно отдать, продать или сдать в переработку.",1],
  ["Чтобы сэкономить воду, лучше набирать полную ванну.",1,"Миф: короткий душ расходует гораздо меньше воды.",1],["Озоновая дыра над Антарктидой постепенно затягивается.",0,"Правда: после запрета вредных веществ озоновый слой восстанавливается.",3],
  ["Медузы почти полностью состоят из воды.",0,"Правда: вода - около 95% тела медузы.",1],["Все змеи ядовиты.",1,"Миф: большинство змей неядовиты.",1],
  ["Лес задерживает пыль и делает воздух чище.",0,"Правда: листья и хвоя собирают пыль из воздуха.",1],["Слоны боятся мышей.",1,"Миф: это популярная выдумка, у неё нет научных подтверждений.",1],
  ["Вода покрывает большую часть поверхности Земли.",0,"Правда: около 70% поверхности планеты - это вода.",1],["Озоновая дыра - главная причина глобального потепления.",1,"Миф: это разные проблемы. Потепление вызывают парниковые газы, а озоновый слой защищает от ультрафиолета.",3],
  ["Океан поглощает значительную часть углекислого газа, который выбрасывают люди.",0,"Правда: океан поглощает примерно четверть выбросов CO₂, но из-за этого его вода становится более кислой.",3],["Из-за поглощения CO₂ вода в океане постепенно становится более кислой.",0,"Правда: это называют закислением океана. Оно мешает кораллам и моллюскам строить раковины и скелеты.",3],
  ["Метан удерживает тепло в атмосфере сильнее, чем такое же количество углекислого газа.",0,"Правда: метан в десятки раз сильнее CO₂, хотя в атмосфере он держится меньше.",3],["Пластик с любой цифрой в треугольнике обязательно примут в переработку.",1,"Миф: цифра лишь обозначает вид пластика. Некоторые виды, например 3 (ПВХ) и 7 (другие), перерабатывают редко.",3],
  ["Электромобиль совсем не влияет на окружающую среду.",1,"Миф: на производство аккумуляторов нужны металлы и энергия, а электричество часто получают из угля и газа. Но выхлопа в городе у электромобиля нет.",3],["Получить алюминий из переработанных банок намного дешевле по энергии, чем из руды.",0,"Правда: переработка алюминия экономит около 95% энергии.",3],
  ["Любой биопластик быстро разлагается в природе.",1,"Миф: некоторые биопластики разлагаются только в промышленном компосте при высокой температуре, а некоторые не разлагаются вовсе.",3],["Свалки - один из крупных источников метана.",0,"Правда: пищевые и другие органические отходы гниют без доступа воздуха и выделяют метан.",3],
  ["Климат и погода - одно и то же.",1,"Миф: погода - состояние атмосферы сейчас, а климат - многолетний режим погоды в местности.",3],["Лишайники помогают понять, насколько чистый воздух.",0,"Правда: многие лишайники не растут там, где воздух загрязнён. Их используют как живые индикаторы.",3],
  ["Борщевик Сосновского - опасное для человека инвазивное растение.",0,"Правда: его сок на солнце вызывает сильные ожоги, а сам борщевик вытесняет местные растения.",3],["Переработка полностью решает проблему пластикового мусора.",1,"Миф: в мире перерабатывается лишь около десятой части пластиковых отходов. Важнее сокращать одноразовый пластик.",3],
  ["Атомные электростанции выбрасывают в атмосферу много углекислого газа.",1,"Миф: при работе АЭС почти не дают CO₂. Их главные проблемы - радиоактивные отходы и безопасность.",3],["Сажа, оседая на снег и лёд, ускоряет их таяние.",0,"Правда: тёмная поверхность сильнее нагревается солнцем.",3],
  ["Если растает плавающий морской лёд Арктики, уровень океана сильно поднимется.",1,"Миф: плавающий лёд уже вытесняет воду. Уровень поднимается из-за таяния ледников на суше и расширения тёплой воды.",3],["Торфяные болота хранят больше углерода, чем все леса планеты.",0,"Правда: торфяники занимают около 3% суши, но хранят примерно вдвое больше углерода, чем леса. Осушать их опасно для климата.",3],
  ["Сжигание мусора - безвредный способ избавиться от любых отходов.",1,"Миф: при сжигании образуются ядовитые вещества и зола, которую тоже нужно где-то хранить.",3],["Шум тоже считается загрязнением окружающей среды.",0,"Правда: сильный постоянный шум вредит здоровью людей и мешает животным общаться.",3],
  ["Ночное освещение городов мешает перелётным птицам и насекомым.",0,"Правда: это световое загрязнение. Яркий свет сбивает птиц с пути и губит ночных насекомых.",3],["Влажные салфетки можно смывать в унитаз - они растворяются, как туалетная бумага.",1,"Миф: салфетки не распадаются, забивают канализацию, а многие содержат синтетические волокна.",3],
  ["На производство одной хлопковой футболки уходят тысячи литров воды.",0,"Правда: больше всего воды нужно, чтобы вырастить хлопок. Поэтому одежду стоит носить дольше.",3],["Бумажный пакет всегда экологичнее пластикового.",1,"Миф: на производство бумажного пакета тратится больше воды и энергии. Экологичнее всего - многоразовая сумка, которой пользуются много раз.",3],
  ["Выращивание масличной пальмы - одна из причин вырубки тропических лесов.",0,"Правда: в Юго-Восточной Азии под плантации вырубают леса, где живут орангутаны и другие редкие животные.",3],["Редкие животные исчезают только из-за браконьеров.",1,"Миф: главная причина - разрушение мест обитания: вырубка лесов, осушение болот, застройка.",3],
  ["Чем выше организм в пищевой цепи, тем меньше в нём накапливается ядов.",1,"Миф: наоборот, некоторые яды накапливаются, и у хищников на вершине цепи их больше всего.",3],["Электронные отходы - один из самых быстрорастущих видов мусора в мире.",0,"Правда: техники становится всё больше, а сдают на переработку лишь небольшую часть.",3],
  ["Озон у самой земли полезен, потому что защищает от ультрафиолета.",1,"Миф: защищает озон высоко в стратосфере. У земли озон - вредная часть смога, он раздражает лёгкие.",3],["В Красной книге России есть не только животные, но и растения и грибы.",0,"Правда: в ней есть отдельные тома для животных и для растений и грибов.",3],
  ["Если вид занесли в Красную книгу, ему больше ничего не угрожает.",1,"Миф: Красная книга - это список видов под угрозой. Чтобы их сохранить, нужно охранять места, где они живут.",3],["Старые холодильники и кондиционеры нужно сдавать на утилизацию, а не выбрасывать.",0,"Правда: в них есть газы-хладагенты, которые усиливают парниковый эффект, а некоторые старые ещё и разрушают озон.",3]]},
 act:{per:3,q:[
  ["На улице лежит использованная батарейка. Как поступить?",["Взять и сдать в пункт приёма","Выкинуть в ближайшую урну","Оставить на месте"],"Батарейка в урне или на земле отравляет почву. Лучше донести её до пункта приёма.",1],["Ты идёшь в магазин за хлебом. Что взять с собой?",["Свою сумку","Ничего - купишь пакет","Два пакета на всякий случай"],"Своя сумка заменяет сотни одноразовых пакетов.",1],
  ["После пикника остался мусор, а урна далеко. Что делать?",["Собрать мусор и донести до урны","Спрятать под кустом","Сжечь в костре"],"Сжигать пластик опасно, а мусор под кустом вредит животным.",1],["В комнате никого нет, а свет горит. Как поступить?",["Выключить свет","Оставить - вдруг кто-то вернётся","Включить ещё и телевизор"],"Выключенный свет - самый простой способ сберечь энергию.",1],
  ["У тебя есть старые, но целые игрушки. Что с ними сделать?",["Отдать тем, кому они нужны","Выбросить в мусор","Сломать"],"Вещи, которые служат дольше, - это меньше мусора.",1],["Друг хочет бросить пластиковую бутылку на газон. Что сделать?",["Предложить донести её до контейнера для пластика","Промолчать","Тоже бросить свою"],"Вежливо подсказать другу - это тоже забота о природе.",1],
  ["Ты чистишь зубы. Что делать с водой?",["Закрыть кран, пока чистишь","Пусть течёт","Открыть посильнее"],"Закрытый кран экономит несколько литров воды каждый раз.",1],["До школы 10 минут пешком. Как лучше добраться?",["Пешком или на велосипеде","Попросить отвезти на машине","Вызвать такси"],"Пешая прогулка не загрязняет воздух и полезна для здоровья.",1],
  ["В парке на земле сидит птенец. Как поступить?",["Не трогать и понаблюдать издалека - родители рядом","Забрать домой","Унести в коробке"],"Слётков обычно кормят родители. Человек может им только помешать.",1],["Ты покупаешь напиток. Что выбрать?",["Без трубочки или со своей многоразовой","Взять три трубочки","Взять трубочку и сразу выбросить"],"Одноразовые трубочки часто попадают в моря и вредят животным.",2],
  ["На кухне остались очистки от овощей. Что с ними сделать?",["Отправить в компост, если он есть","Выбросить в реку","Сжечь"],"Из очисток получается полезное удобрение.",1],["После урока работают проектор и компьютер. Что сделать?",["Выключить, если они больше не нужны","Оставить до завтра","Не обращать внимания"],"Техника в режиме ожидания тоже тратит электричество.",1],
  ["Старая футболка ещё хорошая, но хочется новую. Как поступить?",["Носить старую, пока она в порядке","Выбросить старую сразу","Купить сразу пять новых"],"На производство одежды уходит много воды и энергии.",2],["В школе из крана капает вода. Что сделать?",["Сказать взрослым, чтобы починили","Ничего","Открыть кран сильнее"],"Из капающего крана за день утекает много воды.",1],
  ["Тебе дали ненужную листовку. Что с ней сделать?",["Сдать в макулатуру","Бросить на землю","Сжечь"],"Бумага может стать новой бумагой, если её сдать.",1],["Зимой птицам голодно. Как им помочь?",["Сделать кормушку с несолёными семечками","Покормить чипсами","Бросить заплесневелый хлеб"],"Солёное и испорченное птицам вредно, а несолёные семечки - в самый раз.",1],
  ["Как принести обед в школу?",["В многоразовом контейнере","В трёх пакетах","В одноразовой посуде"],"Многоразовый контейнер служит годами и не становится мусором.",1],["Погода сухая и ветреная, а хочется развести костёр в лесу. Как поступить?",["Не разводить костёр","Развести побольше","Оставить костёр без присмотра"],"В сухую погоду от одной искры может начаться лесной пожар.",1],
  ["В парке кто-то разводит костёр в неположенном месте. Что сделать?",["Сказать взрослым или позвонить 112","Подбросить веток","Ничего не делать"],"При угрозе пожара нужно сразу сообщить взрослым или в службу 112.",1],["Тетрадь закончилась. Что сделать со старой?",["Сдать в макулатуру","Выбросить в лесу","Сжечь во дворе"],"Старые тетради - хорошее сырьё для новой бумаги.",1],
  ["Нужно выбросить пустую стеклянную банку. Как поступить?",["Сполоснуть и отнести в контейнер для стекла","Выбросить в лесу","Разбить и выбросить"],"Чистое стекло переработают в новые банки и бутылки.",1],["Ты уходишь из дома, а компьютер включён. Что сделать?",["Выключить его","Оставить на весь день","Включить ещё и монитор"],"Включённый компьютер тратит электричество впустую.",1],
  ["Жарко, хочется пить. Как поступить?",["Налить воду в свою бутылку","Купить три бутылки воды","Купить воду и выбросить недопитую"],"Своя бутылка - меньше пластикового мусора.",1],["На прогулке встретился ёжик. Как поступить?",["Понаблюдать и не трогать","Забрать домой","Накормить молоком"],"Молоко ежам вредно, а дикие животные должны жить на воле.",1],
