const dayShift=(d,n)=>{const t=new Date(d+"T12:00:00Z");t.setUTCDate(t.getUTCDate()+n);return t.toISOString().slice(0,10)};
function streakOf(uid,pd){const s=new Set(pd.filter(r=>r.userId===uid).map(r=>r.date));let d=today();
