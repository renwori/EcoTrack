   else{addEvent(u.id,"badge",t[1],"Получено достижение «"+title+"»");got.push(title)}}});
 SINGLES.forEach(a=>{const id="ach_"+a[0]+"_"+u.id;if(!by[id]&&a[5](x)){grant(u.id,id,a[1],a[2],a[3],a[4]);got.push(a[3])}});
