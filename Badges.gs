/* ───── эко-карта: серверы OpenStreetMap и общий кэш ───── */
const MAP_RADS=[1000,2000,3000,5000];
const OVP_SRV=["https://overpass-api.de/api/interpreter","https://overpass.private.coffee/api/interpreter","https://maps.mail.ru/osm/tools/overpass/api/interpreter","https://overpass.kumi.systems/api/interpreter"];
const MAP_TAG=/^(name|operator|recycling_type|opening_hours|recycling:[a-z_]+)$/i;
// Только нужное для карты, чтобы ответ помещался в кэш и в ячейку таблицы
function slimPoint(e){const t={},g=e.tags||{};Object.keys(g).forEach(k=>{if(MAP_TAG.test(k)&&(k.indexOf("recycling:")!==0||g[k]==="yes"))t[k]=String(g[k]).slice(0,80)});
 const lat=e.lat!=null?e.lat:e.center&&e.center.lat,lon=e.lon!=null?e.lon:e.center&&e.center.lon;
 return lat==null||lon==null?null:{lat:Math.round(lat*1e6)/1e6,lon:Math.round(lon*1e6)/1e6,tags:t}}
const okOvp=j=>j&&Array.isArray(j.elements)&&!(/runtime error/i.test(j.remark||"")&&!j.elements.length);
// Спрашивает все серверы сразу и берёт первый удачный ответ; если запрос целиком сорвался - по одному
function mapFetch(lat,lon,rad){const dy=rad/111320,dx=rad/(111320*Math.cos(lat*Math.PI/180)),bb=[lat-dy,lon-dx,lat+dy,lon+dx].map(v=>v.toFixed(5)).join(",");
 const q='[out:json][timeout:20];(node["amenity"="recycling"]('+bb+');way["amenity"="recycling"]('+bb+'););out center qt 200;';
 const req=u=>({url:u,method:"post",payload:{data:q},muteHttpExceptions:true}),parse=r=>{try{if(r.getResponseCode()!==200)return null;const j=JSON.parse(r.getContentText());return okOvp(j)?j.elements:null}catch(e){return null}};
 try{for(const r of UrlFetchApp.fetchAll(OVP_SRV.map(req))){const el=parse(r);if(el)return el}return null}catch(e){}
 for(const u of OVP_SRV){try{const el=parse(UrlFetchApp.fetch(u,req(u)));if(el)return el}catch(e){}}
 return mapNominatim(lat,lon,rad)}
// Запасной источник - Nominatim (поиск OpenStreetMap): до 50 пунктов, отвечает быстро
function mapNominatim(lat,lon,rad){const dy=rad/111320,dx=rad/(111320*Math.cos(lat*Math.PI/180)),vb=[lon-dx,lat+dy,lon+dx,lat-dy].map(v=>v.toFixed(5)).join(",");
 try{const r=UrlFetchApp.fetch("https://nominatim.openstreetmap.org/search?format=jsonv2&q="+encodeURIComponent("[amenity=recycling]")+"&viewbox="+vb+"&bounded=1&limit=50&extratags=1&accept-language=ru",
   {muteHttpExceptions:true,headers:{Referer:"https://renwori.github.io/EcoTrack/"}});if(r.getResponseCode()!==200)return null;const j=JSON.parse(r.getContentText());if(!Array.isArray(j))return null;
  return j.map(x=>({lat:+x.lat,lon:+x.lon,tags:Object.assign({},x.extratags||{},x.name?{name:x.name}:{})}))}catch(e){return null}}
const mapKey=(lat,lon,rad)=>"map_"+Number(lat).toFixed(2)+"_"+Number(lon).toFixed(2)+"_"+rad;
function mapQueueAdd(key){const C=CacheService.getScriptCache();let q=[];try{q=JSON.parse(C.get("map_queue")||"[]")}catch(e){}
 if(q.indexOf(key)<0){q.unshift(key);C.put("map_queue",JSON.stringify(q.slice(0,30)),21600)}}
// Фоновая работа: берёт места из очереди и запрашивает пункты у серверов карты (не дольше ~4 минут за раз)
function mapQueueRun(){const C=CacheService.getScriptCache(),t0=Date.now();let q=[];try{q=JSON.parse(C.get("map_queue")||"[]")}catch(e){}
 const done=[],failed=[];
 for(const key of q.slice()){if(Date.now()-t0>4*60e3)break;
  const m=/^map_(-?[\d.]+)_(-?[\d.]+)_(\d+)$/.exec(key);if(!m){q=q.filter(k=>k!==key);continue}
  const el=mapFetch(+m[1],+m[2],+m[3]);
  if(el){mapSave(key,el);done.push(key);q=q.filter(k=>k!==key);C.put("map_queue",JSON.stringify(q),21600)}else failed.push(key)}
 C.put("map_queue",JSON.stringify(q),21600);
 return"Эко-карта: загружено мест - "+done.length+", не ответили серверы - "+failed.length+", в очереди - "+q.length}
function mapSave(key,el){const slim=el.map(slimPoint).filter(Boolean).slice(0,200);let data=JSON.stringify(slim);
 while(data.length>45000&&slim.length>10){slim.length=Math.floor(slim.length*0.8);data=JSON.stringify(slim)}
 CacheService.getScriptCache().put(key,data,21600);
 withLock(()=>{const h=mapCacheFind(key);if(h)setRow("MapCache",h.row,[key,data,now()]);else addT("MapCache",[key,data,now()]);mapCachePrune()});return slim}
function mapCacheFind(key){ensure("MapCache");const sh=SS().getSheetByName("MapCache"),n=sh.getLastRow()-1;if(n<1)return null;
 const ks=sh.getRange(2,1,n,1).getValues();let i=-1;for(let k=0;k<ks.length;k++)if(String(ks[k][0])===key){i=k;break}
 if(i<0)return null;const v=sh.getRange(i+2,1,1,3).getValues()[0];return{row:i+2,data:String(v[1]),updated:String(v[2])}}
// не больше 200 мест в кэше: самые старые удаляются
function mapCachePrune(){const sh=SS().getSheetByName("MapCache"),n=sh.getLastRow()-1;if(n<=200)return;
 const up=sh.getRange(2,3,n,1).getValues().map((r,i)=>({row:i+2,u:String(r[0])})).sort((a,b)=>a.u<b.u?-1:1).slice(0,n-200);
 up.map(x=>x.row).sort((a,b)=>b-a).forEach(r=>sh.deleteRow(r))}
function activeEvent(){const t=today(),y=+t.slice(0,4);
 for(const e of SEASON){const d=e[3](y);if(t>=dayShift(d,-3)&&t<=dayShift(d,3))
  return{id:e[0],name:e[1],emoji:e[2],date:d,year:y,until:dayShift(d,3),task:e[4]}}return null}
function taskById(id){id=String(id);if(id.indexOf("e:")===0){const e=SEASON.find(x=>x[0]===id.split(":")[1]);return e?Object.assign({event:e[0],eventName:e[1],eventEmoji:e[2]},e[4]):null}
 return TASKS.find(x=>x.id==id)||null}

/* ───── вопрос дня ───── */
function seeded(arr,h){const a=arr.slice();let x=h||1;for(let i=a.length-1;i>0;i--){x=(x*1103515245+12345)%2147483648;const j=x%(i+1);[a[i],a[j]]=[a[j],a[i]]}return a}
// Вопрос дня один на всех ребят своей возрастной группы (1-4, 5-8, 9-11 класс).
function qotdItem(band){const t=today(),pq=poolOf(GAMES.quiz,band),pm=poolOf(GAMES.myth,band),nq=pq.length;let h=7;for(const ch of t+"qotd"+(band||""))h=(h*31+ch.charCodeAt(0))%1000003;
 const i=h%(nq+pm.length);if(i<nq){const q=GAMES.quiz.q[pq[i]],ord=seeded([0,1,2,3],h);return{q:q[0],o:ord.map(k=>q[1][k]),ix:ord,right:0,e:q[2]}}
 const q=GAMES.myth.q[pm[i-nq]];return{q:q[0],o:["Правда","Миф"],ix:[0,1],right:q[1],e:q[2]}}
function qotdOut(u){const band=bandOf(u),it=qotdItem(band),my=rows("Qotd").find(r=>r.date===today()&&r.userId===u.id);
 // статистика - только среди тех, у кого был тот же вопрос
 const U={};rows("Users").forEach(x=>U[x.id]=x);
 const all=rows("Qotd").filter(r=>r.date===today()&&U[r.userId]&&bandOf(U[r.userId])===band);
 const o={q:it.q,o:it.o,ix:it.ix,answered:null,band:BAND_NAME[band]||""};
 if(!my)o.k=enc({r:it.right,e:it.e});
 if(my)Object.assign(o,{answered:{a:Number(my.answer),ok:my.ok==="1",right:it.right,e:it.e},stats:{n:all.length,ok:all.filter(r=>r.ok==="1").length}});
 return o}

/* ───── рейтинги и соревнование классов ───── */
function scoreMap(metric,ids,since){const m={};ids.forEach(id=>m[id]=0);
 if(metric==="xp")tail("XpLog",30000).forEach(r=>{if(r.date>=since&&r.userId in m)m[r.userId]+=Number(r.xp)||0});
 else if(metric==="tasks")tail("DailyTasks",30000).forEach(r=>{if(r.done==="1"&&r.date>=since&&r.userId in m)m[r.userId]++});
 else{const pd=tail("PlayDays",30000);ids.forEach(id=>m[id]=streakOf(id,pd))}
 return m}
function classTeacherFor(u,name){if(name){const t=byName(name);if(t&&(t.id===u.id&&isStaff(u)||isMember(t.id,u.id)))return t;throw"Вы не состоите в этом классе"}
 if(isStaff(u)&&rows("Classes").some(c=>c.teacherId===u.id))return u;
 const m=rows("Members").find(x=>x.studentId===u.id);return m?byId(m.teacherId):null}
function classesRating(u){const users=rows("Users"),cls=rows("Classes"),mem=rows("Members"),log=tail("XpLog",30000),dt=tail("DailyTasks",30000);
 const ms=monthStart(0),pms=monthStart(-1);
 const calc=(c,from,to)=>{const ids=mem.filter(m=>m.teacherId===c.teacherId).map(m=>m.studentId),set=new Set(ids);let xp=0,tasks=0;
  log.forEach(r=>{if(set.has(r.userId)&&r.date>=from&&r.date<to)xp+=Number(r.xp)||0});
  dt.forEach(r=>{if(set.has(r.userId)&&r.done==="1"&&r.date>=from&&r.date<to)tasks++});
  return{count:ids.length,avg:ids.length?Math.round(xp/ids.length):0,tasks}};
 const label=c=>{const t=users.find(x=>x.id===c.teacherId);return{name:c.name,teacher:t?mini(t):null}};
 const list=cls.map(c=>Object.assign(label(c),calc(c,ms,"9999"),{mine:c.teacherId===u.id||mem.some(m=>m.teacherId===c.teacherId&&m.studentId===u.id)}))
  .filter(c=>c.count>0).sort((a,b)=>b.avg-a.avg||b.tasks-a.tasks);
 const prev=cls.map(c=>Object.assign(label(c),calc(c,pms,ms))).filter(c=>c.count>0&&c.avg>0).sort((a,b)=>b.avg-a.avg)[0]||null;
 const mi=+today().slice(5,7)-1;
 return{scope:"classes",classes:list.slice(0,50),prev,month:MONTHS[mi],prevMonth:MONTHS[(mi+11)%12]}}

