/* ───── вопрос дня ───── */
function seeded(arr,h){const a=arr.slice();let x=h||1;for(let i=a.length-1;i>0;i--){x=(x*1103515245+12345)%2147483648;const j=x%(i+1);[a[i],a[j]]=[a[j],a[i]]}return a}
// Вопрос дня один на всех ребят своей возрастной группы (1-4, 5-8, 9-11 класс).
function qotdItem(band){const t=today(),pq=poolOf(GAMES.quiz,band),pm=poolOf(GAMES.myth,band),nq=pq.length;let h=7;for(const ch of t+"qotd"+(band||""))h=(h*31+ch.charCodeAt(0))%1000003;
 const i=h%(nq+pm.length);if(i<nq){const q=GAMES.quiz.q[pq[i]],ord=seeded([0,1,2,3],h);return{q:q[0],o:ord.map(k=>q[1][k]),ix:ord,right:0,e:q[2]}}
 const q=GAMES.myth.q[pm[i-nq]];return{q:q[0],o:["Правда","Миф"],ix:[0,1],right:q[1],e:q[2]}}
function qotdOut(u){const band=bandOf(u),it=qotdItem(band),my=rows("Qotd").find(r=>r.date===today()&&r.userId===u.id);
 // статистика - только среди тех, у кого был тот же вопрос
 const U={};rows("Users").forEach(x=>U[x.id]=x);
 const all=rows("Qotd").filter(r=>r.date===today()&&U[r.userId]&&bandOf(U[r.userId])===band);
 const o={q:it.q,o:it.o,ix:it.ix,answered:null,band:BAND_NAME[band]||""};
 if(my)Object.assign(o,{answered:{a:Number(my.answer),ok:my.ok==="1",right:it.right,e:it.e},stats:{n:all.length,ok:all.filter(r=>r.ok==="1").length}});
 return o}

