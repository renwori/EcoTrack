 bumpCounters(u,{games:1,perfect:total&&score===total?1:0,correct:G.order?0:score,best:streak,freeze:-froze,chests:(chest?1:0)+(dayChest?1:0),dayChest:dayChest?ymd()-cn.dayChest:0},cn);
